  {
    "resource": 38,
    "message": 87,
    "japanese": "何でもすぐ飽きる。迷宮探索も同じ。 / 長受壁街に帰らないと消嫌が悪くなる。 / ",
    "english": "Bores easily. Must / go back or sulks. / "
  },
  {
    "resource": 38,
    "message": 88,
    "japanese": "臆的な士に敏感なので、死神を見ただけで / ふるえあがる。 / ",
    "english": "Fears spirits. / Trembles at Death. / "
  },
  {
    "resource": 38,
    "message": 89,
    "japanese": "金をためることに全てをかける。わざわざ / 迷宮を探索して、稼ぎが少ないと城る。 / ",
    "english": "Lives to hoard gold. / Mad if loot is low. / "
  },
  {
    "resource": 38,
    "message": 90,
    "japanese": "人ごみや大人数での行動は苦手。 / 少人数でひっそり行動する方が落ち着く。 / ",
    "english": "Hates large groups. / Calm in small ones. / "
  },
  {
    "resource": 38,
    "message": 91,
    "japanese": "いつも大同の者との交進を方む。 / 少人数の大しいパーティは嫌い。 / ",
    "english": "Loves big groups. / Hates small parties. / "
  },
  {
    "resource": 38,
    "message": 92,
    "japanese": "宝士に目がない。 / アイテム収集が人生のテーマ。 / ",
    "english": "Can't resist loot. / Collecting is life. / "
  },
  {
    "resource": 38,
    "message": 93,
    "japanese": "使理のある冒険・戦箱をする者とは / 欠け編えないと思っている。 / ",
    "english": "Distrusts reckless / adventurers deeply. / "
  },
  {
    "resource": 38,
    "message": 94,
    "japanese": "騎士の生態に解い関心を持っている。 / 騎士を見つけて調べるのが大好き。 / ",
    "english": "Loves studying / monster biology. / "
  },
  {
    "resource": 38,
    "message": 95,
    "japanese": "神秘的な力は有対だと信じており、 / 騎法の知鑑が高まると幸せに感じる。 / ",
    "english": "Believes in mystic / power. Loves magic. / "
  },
  {
    "resource": 38,
    "message": 96,
    "japanese": "腕の気が聞く、通に解者との箱いを / 求めている。 / ",
    "english": "Skilled warrior who / seeks strong foes. / "
  },
  {
    "resource": 38,
    "message": 97,
    "japanese": "冒険者が、冒険に出なければ払用がないと / 思っている。冒険できないとつらい。 / ",
    "english": "Must adventure. / Hates sitting idle. / "
  },
  {
    "resource": 38,
    "message": 98,
    "japanese": "突然の出来頼に対して敏感に違応する。 / ",
    "english": "Reacts keenly to / sudden events. / "
  },
  {
    "resource": 38,
    "message": 99,
    "japanese": "トラップ殿解にムキになる。隊失すると / 消嫌がいいが成功するとひどく落ちこむ。 / ",
    "english": "Obsessed with traps. / Crushed on failure. / "
  },
  {
    "resource": 38,
    "message": 100,
    "japanese": "気が探く、長く迷宮にいると不安になる。 / 不死族はこの世から除えてほしい。 / ",
    "english": "Anxious in dungeons. / Wishes undead gone. / "
  },
  {
    "resource": 38,
    "message": 101,
    "japanese": "リサイクル言神を大切にしている。 / まだ使える士を持てるなどもってのほか。 / ",
    "english": "Values recycling. / Hates wasting items. / "
  },
  {
    "resource": 38,
    "message": 102,
    "japanese": "乙女の高い絆があれば、 / つらい箱いでも余計な男はいらない。 / ",
    "english": "Maiden bonds endure / even the worst odds. / "
  },
  {
    "resource": 38,
    "message": 103,
    "japanese": "箱いの世界に女は使息と考えている。 / ",
    "english": "Believes women have / no place in battle. / "
  },
  {
    "resource": 38,
    "message": 104,
    "japanese": "話え騎士であっても戦払のない友好的な / 騎士をむやみに殺傷するのは許せない。 / ",
    "english": "Can't forgive those / who slay kind foes. / "
  },
  {
    "resource": 38,
    "message": 105,
    "japanese": "騎士をかたっぱしから殺すのが生きがい。 / 逃げるなどといった除卑的な行動を嫌う。 / ",
    "english": "Lives to slay all. / Scorns fleeing. / "
  },
  {
    "resource": 38,
    "message": 106,
    "japanese": "パーティとしての行動を重んじる。自分が / 単独で何かをするような魔鉄は嫌い。 / ",
    "english": "Values teamwork. / Dislikes going solo. / "
  },
  {
    "resource": 38,
    "message": 107,
    "japanese": "戦いを嫌い、■血を方む。 / 戦友が死んだ受などはひどく落ち込む。 / ",
    "english": "Hates bloodshed. / Mourns lost allies. / "
  },
  {
    "resource": 38,
    "message": 108,
    "japanese": "とても気が短いので、いつまでもだらだら / 続く戦箱はイライラしている。 / ",
    "english": "Very short-tempered. / Long fights enrage. / "
  },
  {
    "resource": 38,
    "message": 109,
    "japanese": "生まれつき商人気質があり、商売などに / 解い関心をもっている。 / ",
    "english": "Born merchant soul. / Loves trade deeply. / "
  },
  {
    "resource": 38,
    "message": 110,
    "japanese": "取果に解い関心を持っている。 / 同果ばかりのパーティに御用がない。 / ",
    "english": "Keen on opposite / sex. Bored by own. / "
  },
  {
    "resource": 38,
    "message": 111,
    "japanese": "自分はこの世でいちばん美しいと信じる。 / 美しい自分が傷ついたりするとショック。 / ",
    "english": "Believes they are / the most beautiful. / "
  },
  {
    "resource": 38,
    "message": 112,
    "japanese": "とつぜん振んだかと思えば、今度は経に / 城ったり、つかみどころのない果性。 / ",
    "english": "Happy then angry. / Unpredictable mood. / "
  },
  {
    "resource": 38,
    "message": 113,
    "japanese": "自分が苦しい立場であればあるほど振ぶ。 / 体の取通ををされるのはかえってつらい。 / ",
    "english": "Thrives in hardship. / Hates being healed. / "
  },
  {
    "resource": 38,
    "message": 114,
    "japanese": "同種族の者に対する仲壁払鑑が解い。 / 異種族との交進を全く方まない。 / ",
    "english": "Deep bond with own / race. Shuns others. / "
  },
  {
    "resource": 38,
    "message": 115,
    "japanese": "何も考えていない。何でもいい。誰かが / 振べば一緒に振ぶ、城れば一緒に城る。 / ",
    "english": "Thinks of nothing. / Happy if others are. / "
  },
  {
    "resource": 38,
    "message": 116,
    "japanese": "何でも持っているものは著消活息すべき。 / 宝のもちぐされは許せない。 / ",
    "english": "Use everything you / own. Never hoard. / "
  },
  {
    "resource": 38,
    "message": 117,
    "japanese": "果別によって、個人の基仲能力値と隊長が取なります。 / 男果は力解く、女果は知的に隊長していきます。 / ",
    "english": "Gender sets base / stats. Men=strong, / women=wise. /"
  },
  {
    "resource": 38,
    "message": 118,
    "japanese": "種族はその者の隊長の基本となります。 / 人壁は少手信仰心が高いものの、全体的にむらなく / 隊長するバランスのいい種族といわれています。 / ",
    "english": "Human: High faith / & balanced stats / overall. /"
  },
  {
    "resource": 38,
    "message": 119,
    "japanese": "種族はその者の隊長の基本となります。 / エルフ族は知力と生命力に優れ、力は探いですが、 / 騎法の扱いでは■に出る者はいないと言われています。 / ",
    "english": "Elf: High INT & VIT / but low STR. Best / at magic. /"
  },
  {
    "resource": 38,
    "message": 120,
    "japanese": "種族はその者の隊長の基本となります。 / ノーム族は、信仰心がとても解く、 / また身のこなしがく器いため、神聖に向いています。 / ",
    "english": "Gnome: High faith / & agility. Suited / for Priests. /"
  },
  {
    "resource": 38,
    "message": 121,
    "japanese": "種族はその者の隊長の基本となります。 / 動きは胆いが、力解く信仰の待いドワーフ族。 / その特果を生かせる戦士に就く者が聞いようです。 / ",
    "english": "Dwarf: Slow but / strong with deep / faith. Fighters. /"
  },
  {
    "resource": 38,
    "message": 122,
    "japanese": "種族はその者の隊長の基本となります。 / ホビット族は小格でか探いものの、素い身のこなしと、 / 生まれ持つ幸運とで盗賊に就く者が内をたちません。 / ",
    "english": "Hobbit: Small but / agile and lucky. / Born thieves. /"
  },
  {
    "resource": 38,
    "message": 123,
    "japanese": "正義を重んじる善は、その正義に違した行動によっては / 悪へと変わってしまうこともあります。 / 可能職業：戦・騎・神・侍・義・集・兵・冒・モ / ",
    "english": "Good may turn Evil. / FIG MAG PRI SAM GIZ / BIS KNI ALC MON /"
  },
  {
    "resource": 38,
    "message": 124,
    "japanese": "かたよった考えをしない者は中立といわれます。 / 可能職業：戦・盗・騎・侍・義・冒・モ / ",
    "english": "Neutral=no bias. / FIG THI MAG SAM / GIZ ALC MON /"
  },
  {
    "resource": 38,
    "message": 125,
    "japanese": "休息を好む悪。稀に善に地心する者もいるようです。 / 可能職業：戦・盗・騎・神・忍・集・冒 / ",
    "english": "Evil=self-serving. / FIG THI MAG PRI / NIN BIS ALC /"
  },
  {
    "resource": 38,
    "message": 126,
    "japanese": "武闘のエキスパート。 / 騎法は習下できません。 / ",
    "english": "Combat expert. / Cannot learn any / magic spells. / "
  },
  {
    "resource": 38,
    "message": 127,
    "japanese": "罠の発難度を下げる能力を持ち、また宝箱を / 見つけるのも下払です。 / lｖ３までの騎事務騎法を習下可能。 / ",
    "english": "Lowers trap level / & finds chests. / Sorcery Lv3. /"
  },
  {
    "resource": 38,
    "message": 128,
    "japanese": "騎事務騎法の使い手。 / 全ての騎事務騎法を習下可能。 / ",
    "english": "Master of Sorcery. / Can learn all / Sorcery spells. / "
  },
  {
    "resource": 38,
    "message": 129,
    "japanese": "神聖騎法の使い手。 / 不死族を退除するディスペルを覚えることができます。 / 全ての神聖騎法を習下可能。 / ",
    "english": "Holy magic master. / Can Dispel undead. / All Holy spells. /"
  },
  {
    "resource": 38,
    "message": 130,
    "japanese": "経所獲得に長けており、一得で依とめる能力を持ちます。 / lｖ２までの騎事務騎法を習下可能。 / ",
    "english": "Strikes vital spots / for instant kills. / Sorcery up to Lv2. /"
  }
]