  {
    "resource": 1197,
    "msg_index": 939,
    "japanese": "イおや、新顔さんだね？ゴ",
    "english": "\"A new face?\""
  },
  {
    "resource": 1197,
    "msg_index": 940,
    "japanese": "焼属の[01E0]に腕を持んだ与が、カウンターの向こうから多づいてきた。",
    "english": "A samurai-garbed / man leaned on the / counter and / approached."
  },
  {
    "resource": 1197,
    "msg_index": 941,
    "japanese": "でっ、何の毒ですかい？",
    "english": "What can I do / for you?"
  },
  {
    "resource": 1197,
    "msg_index": 942,
    "japanese": "与は、の両に待ち、じっと[0284]険世い[0284]差しで、見つめている。",
    "english": "He stood there / with a sharp, / piercing gaze."
  },
  {
    "resource": 1197,
    "msg_index": 943,
    "japanese": "落aイだ～めだよマスター。そんな変し所みたいな顔で見つめちゃ、またお落さん威げちゃうよゴ",
