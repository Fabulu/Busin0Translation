[
  {
    "resource": 1196,
    "msg_index": 0,
    "japanese": "階の主を倒声したメダルは[044C]神に[052A]け[0410]った。",
    "english": "The medal earned from / defeating the floor / master was offered."
  },
  {
    "resource": 1196,
    "msg_index": 1,
    "japanese": "近所を出ると、名成の暗に１己の魔物が待っていた。",
    "english": "Upon leaving the area, / a single monster / awaited in the dark."
  },
  {
    "resource": 1196,
    "msg_index": 2,
    "japanese": "その魔物、オークは近所へ出入りする者に[03A2]っ自から何かを[03CF]っている。",
    "english": "The Orc was demanding / something from those / who passed by."
  },
  {
    "resource": 1196,
    "msg_index": 3,
    "japanese": "こちらの武器にも[0141]がつき早[044E]、声をかけてきた。",
    "english": "It noticed our weapons / and called out / to us eagerly."
  },
  {
    "resource": 1196,
    "msg_index": 4,
    "japanese": "オークどうもだど～ オダは、ヴィガーしょうてんのせんでんにやってきたのだ ",
    "english": "Orc: Howdy do~ / I'm here to advertise / for Vigger Shop!"
  },
  {
    "resource": 1196,
    "msg_index": 5,
    "japanese": "いらね～もののカイトリ、よぐわがんね～もののカンテイ、おとろし～のろいのカイジュ ",
    "english": "Buyin' unwanted junk, / identifyin' items, / liftin' curses~"
  },
  {
    "resource": 1196,
    "msg_index": 6,
    "japanese": "そんなのわ、われらがヴィガーしょうてんにおまかせだ～[0267]",
    "english": "Leave all that to / us at Vigger Shop~!"
  },
  {
    "resource": 1196,
    "msg_index": 7,
    "japanese": "ほれっ、オメェもうけとれ ",
    "english": "Here, take this!"
  },
  {
    "resource": 1196,
    "msg_index": 8,
    "japanese": "ごらいてん、まってるだよ ",
    "english": "We'll be waitin' / for ya~!"
  },
  {
    "resource": 1196,
    "msg_index": 9,
    "japanese": "オークは力に[04AF]えていた家帯新の却から１枚を差し出しまた行の者の元へ休って行った。",
    "english": "The Orc handed over / a flyer and rushed / to the next person."
  },
  {
    "resource": 1196,
    "msg_index": 10,
    "japanese": "  アイテムのことなら                ヴィガー商店   [05A7]買３０美の[02BF]全ある店ヴィガー商店あなたのご帰店を目よりお待ちしております。     店消・ルーシー[001D]ヴィガー",
    "english": "  For all your items\n                Vigger Shop\n   30 years of trusted\n service. We await\n your visit.\n     Manager: Lucy"
  },
  {
    "resource": 1196,
    "msg_index": 11,
    "japanese": "[03FE][0375]の家帯新に通かれていた乙[056A]を頼りに、ヴィガー商店らしき場暗へとやってきた。",
    "english": "Following the address / on the flyer, you / found the Vigger Shop."
  },
  {
    "resource": 1196,
    "msg_index": 12,
    "japanese": "胆乙の入り口には消えかかった[021E]でヴィガー商店と書かれた感[0182]があり、ここで嫌違いはないようだ。",
    "english": "A faded sign reading / 'Vigger Shop' hung / at the entrance."
  },
  {
    "resource": 1196,
    "msg_index": 13,
    "japanese": "奥にある集はたいそう待大なのに、その入り口を[0143]祠に慎部して交い間所が追分されている知与な部りの迷物である。",
    "english": "Despite the grand / building behind it, / the shop was tiny."
  },
  {
    "resource": 1196,
    "msg_index": 14,
    "japanese": "そして、ここでもやはりオークが[0457]物を稼んだりしてせっせと傷いていた。",
    "english": "Here too, Orcs were / busily working, / carrying goods."
  },
  {
    "resource": 1196,
    "msg_index": 15,
    "japanese": "ドゥーハンの中目に[04D5][0175]する[03DE]庁[0500]両の[01E8]場にやってきた。",
    "english": "You arrived at the / plaza in the center / of Duhan."
  },
  {
    "resource": 1196,
    "msg_index": 16,
    "japanese": "通り過ぎて行く者や待ち合わせをする者など唱くの者でにぎわっている。",
    "english": "People were passing / through or waiting / for someone."
  },
  {
    "resource": 1196,
    "msg_index": 17,
    "japanese": "[01E8]場の中[04BC]にある[0580]関のすぐ[04D0]には[0596]店が出ている。",
    "english": "Near the main gate / in the plaza, / a stall was set up."
  },
  {
    "resource": 1196,
    "msg_index": 18,
    "japanese": "[0596]店をのぞきますか？は いいいえ",
    "english": "Browse the stall? / Yes / No"
  },
  {
    "resource": 1196,
    "msg_index": 19,
    "japanese": "オークが言っていたとおり、[0596]店はヴィガー商店が開いているものだった。",
    "english": "As the Orc said, / the stall was run by / the Vigger Shop."
  },
  {
    "resource": 1196,
    "msg_index": 20,
    "japanese": "飽[03CE]を果べて以った[0170]にヴィガー商店と書かれた[0268]がかけられている。",
    "english": "A sign reading / 'Vigger Shop' hung / on the stall."
  },
  {
    "resource": 1196,
    "msg_index": 21,
    "japanese": "だが、店番をしているのはオークではなく、れっきとした者嫌の少女であった。",
    "english": "But the shopkeeper / was not an Orc, but / a young human girl."
  },
  {
    "resource": 1196,
    "msg_index": 22,
    "japanese": "店の両に待っていると、店番の少女が大[05A8]そうな顔をしながら声をかけてきた。",
    "english": "As you stood before / the shop, the girl / called out to you."
  },
  {
    "resource": 1196,
    "msg_index": 23,
    "japanese": "少女！なあに？そんなところに待ってちゃ商[0367]の[0159]魔なんだけど！。",
    "english": "Girl: What? Standing / there is bad for / business, you know!"
  },
  {
    "resource": 1196,
    "msg_index": 24,
    "japanese": "アタシの[0159]魔したんだから、お[05A9]びの客町もこめてなんか買ってってよ ",
    "english": "Since you bothered / me, buy something / to make up for it!"
  },
  {
    "resource": 1196,
    "msg_index": 25,
    "japanese": "そう言う少女の[0390][016A]には既に大[05A8]がる[01BC]所が消え、何か[05AA]むような多みが呪かんでいた。",
    "english": "Despite her annoyed / look, a hint of / loneliness showed."
  },
  {
    "resource": 1196,
    "msg_index": 26,
    "japanese": "買い物しますか？は いいいえ",
    "english": "Shop here? / Yes / No"
  },
  {
    "resource": 1196,
    "msg_index": 27,
    "japanese": "内恵よね～。ほらほら、商品を見てよ。とっても声いんだから ",
    "english": "Good choice~! Look at / the goods. They're / really great!"
  },
  {
    "resource": 1196,
    "msg_index": 28,
    "japanese": "なんなの？汝[0368]しちゃう ",
    "english": "What's your deal? / You're annoying!"
  },
  {
    "resource": 1196,
    "msg_index": 29,
    "japanese": "買い物しないんなら店の両につったってないでどいてちょうだい ",
    "english": "If you're not buying, / stop standing in / front of my shop!"
  },
  {
    "resource": 1196,
    "msg_index": 30,
    "japanese": "品った少女に漢い大された！。",
    "english": "The sassy girl / chased you away!"
  },
  {
    "resource": 1196,
    "msg_index": 31,
    "japanese": "少女あら、また帰たの？アタシ物備えがよすぎて、[01C7]れたくても[01C7]れられないのよね～、落の顔。",
    "english": "Girl: Oh, you again? / I'm so charming you / just can't stay away~"
  },
  {
    "resource": 1196,
    "msg_index": 32,
    "japanese": "ここへ帰たからにはもちろん買い物してってくれるってことよね？",
    "english": "Since you came back, / you'll buy something, / right?"
  },
  {
    "resource": 1196,
