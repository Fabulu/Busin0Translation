 "rects": [
  {"seq": 0,   "page": "img0",  "u": 0,   "v": 0,   "w": 184, "jp": "無数の怨霊によって",             "en": "By countless spirits"},
  {"seq": 1,   "page": "img0",  "u": 0,   "v": 24,  "w": 264, "jp": "アシラの肉体は喰い尽くされ",     "en": "Ashira's flesh was devoured,"},
  {"seq": 3,   "page": "img0",  "u": 0,   "v": 48,  "w": 168, "jp": "異空の裂け目へと",               "en": "and into the rift"},
  {"seq": 4,   "page": "img0",  "u": 0,   "v": 72,  "w": 184, "jp": "吸い込まれていった",             "en": "between worlds it fell."},
  {"seq": 6,   "page": "img0",  "u": 0,   "v": 96,  "w": 184, "jp": "その異空の裂け目は",             "en": "That rift in the void"},
  {"seq": 7,   "page": "img0",  "u": 0,   "v": 120, "w": 152, "jp": "未だ脈動を続け",                 "en": "pulses still,"},
  {"seq": 9,   "page": "img0",  "u": 0,   "v": 144, "w": 184, "jp": "新たなる蠢くものを",             "en": "striving to give birth to"},
  {"seq": 10,  "page": "img0",  "u": 0,   "v": 168, "w": 200, "jp": "産みだそうとしている",           "en": "a new, writhing thing."},
  {"seq": 12,  "page": "img1",  "u": 0,   "v": 0,   "w": 232, "jp": "すべてを終わらせるため",         "en": "To put an end to it all,"},
  {"seq": 13,  "page": "img1",  "u": 0,   "v": 24,  "w": 176, "jp": "いまこそ闇の炎を",               "en": "now, the dark flame..."},
  {"seq": 14,  "page": "img0",  "u": 0,   "v": 240, "w": 240, "jp": "いずこからか聞こえてきた",       "en": "From somewhere there came"},
  {"seq": 15,  "page": "img0",  "u": 0,   "v": 264, "w": 168, "jp": "女性の声とともに",               "en": "a woman's voice,"},
  {"seq": 16,  "page": "img0",  "u": 0,   "v": 288, "w": 232, "jp": "一陣の風が舞い上がった",         "en": "and a gust of wind rose."},
  {"seq": 18,  "page": "img0",  "u": 0,   "v": 312, "w": 168, "jp": "風は一行の手から",               "en": "From the party's"},
  {"seq": 19,  "page": "img0",  "u": 0,   "v": 336, "w": 264, "jp": "闇の炎が封じ込められた石を",     "en": "hands, the wind tore away"},
  {"seq": 20,  "page": "img0",  "u": 0,   "v": 360, "w": 144, "jp": "さらっていった",                 "en": "the sealing stone."},
  {"seq": 22,  "page": "img0",  "u": 0,   "v": 384, "w": 216, "jp": "噴き上げる風に乗って",           "en": "On the surging wind,"},
  {"seq": 24,  "page": "img0",  "u": 0,   "v": 408, "w": 232, "jp": "上空の異空の裂け目へと",         "en": "up into the rift on high,"},
  {"seq": 25,  "page": "img0",  "u": 0,   "v": 432, "w": 264, "jp": "闇の炎は吸い込まれていった",     "en": "the dark flame was drawn."},
  {"seq": 27,  "page": "img0",  "u": 0,   "v": 456, "w": 168, "jp": "異空の裂け目から",               "en": "And from the rift,"},
  {"seq": 29,  "page": "img0",  "u": 0,   "v": 480, "w": 264, "jp": "大地を揺るがす轟音とともに",     "en": "with an earth-shaking roar,"},
  {"seq": 31,  "page": "img0",  "u": 240, "v": 0,   "w": 192, "jp": "閃光がほとばしった",             "en": "a flash of light burst."},
  {"seq": 33,  "page": "img0",  "u": 264, "v": 24,  "w": 240, "jp": "悲しげな歌が聞こえていた",       "en": "A sorrowful song was heard."},
  {"seq": 35,  "page": "img0",  "u": 240, "v": 48,  "w": 216, "jp": "哀切に満ちたその声は",           "en": "That voice, full of grief,"},
  {"seq": 37,  "page": "img0",  "u": 240, "v": 72,  "w": 208, "jp": "二度と戻ることのない",           "en": "sang of the warriors"},
  {"seq": 38,  "page": "img0",  "u": 240, "v": 96,  "w": 264, "jp": "戦士達の魂を歌い上げている",     "en": "who will never return."},
  {"seq": 40,  "page": "img1",  "u": 264, "v": 48,  "w": 184, "jp": "永劫の時の流れに",               "en": "In time's endless flow,"},
  {"seq": 42,  "page": "img1",  "u": 232, "v": 0,   "w": 280, "jp": "塵へと還った無数の戦士達よ",     "en": "O warriors returned to dust..."},
  {"seq": 44,  "page": "img1",  "u": 232, "v": 24,  "w": 280, "jp": "剣の下に集った懐かしき日々",     "en": "Dear days beneath the sword,"},
  {"seq": 46,  "page": "img1",  "u": 256, "v": 312, "w": 256, "jp": "友と語らった楽しき思い出",       "en": "glad hours shared with friends,"},
  {"seq": 48,  "page": "img1",  "u": 256, "v": 336, "w": 256, "jp": "かなうことのなかった夢や",       "en": "dreams that never came true,"},
  {"seq": 50,  "page": "img1",  "u": 256, "v": 360, "w": 256, "jp": "悲しみに涙した敗北ですら",       "en": "even defeats we wept over -"},
  {"seq": 52,  "page": "img1",  "u": 0,   "v": 488, "w": 312, "jp": "すべては輝ける闇の中に存在した", "en": "all of it lived in the shining dark."},
  {"seq": 53,  "page": "img0",  "u": 240, "v": 288, "w": 272, "jp": "その声は切々とうったえている",   "en": "The voice pleaded earnestly:"},
  {"seq": 57,  "page": "img1",  "u": 272, "v": 384, "w": 136, "jp": "もし あの日",                    "en": "If, that day,"},
  {"seq": 58,  "page": "img1",  "u": 272, "v": 408, "w": 240, "jp": "神がたった一つの願いを",         "en": "the gods had granted"},
