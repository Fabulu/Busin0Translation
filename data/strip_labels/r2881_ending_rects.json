  {"seq": 97,  "page": "img1",  "u": 8,   "v": 408, "w": 264, "jp": "私を助け 闇の勢力と戦う",        "en": "who aid me against the dark,"},
  {"seq": 99,  "page": "img1",  "u": 8,   "v": 432, "w": 264, "jp": "大いなるアレイドの具現者",       "en": "the great Allied made flesh -"},
