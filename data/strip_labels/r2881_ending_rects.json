  {"seq": 63,  "page": "img0",  "u": 264, "v": 408, "w": 216, "jp": "空には紙ふぶきが舞い",           "en": "Confetti filled the sky,"},
  {"seq": 65,  "page": "img0",  "u": 264, "v": 432, "w": 240, "jp": "街には平和の訪れに喜ぶ",         "en": "and through the streets"},
  {"seq": 66,  "page": "img0",  "u": 264, "v": 456, "w": 248, "jp": "歓呼の声が響き渡っていた",       "en": "rang cheers for the peace."},
  {"seq": 68,  "page": "img0",  "u": 264, "v": 480, "w": 240, "jp": "各国の王族や大使の前で",         "en": "Before royals and envoys,"},
  {"seq": 69,  "page": "img0",  "u": 272, "v": 120, "w": 224, "jp": "王女オリアーナは",               "en": "Princess Oriana,"},
  {"seq": 70,  "page": "img0",  "u": 240, "v": 144, "w": 272, "jp": "新女王として力強く宣言した",     "en": "as new Queen, declared:"},
  {"seq": 72,  "page": "img1",  "u": 0,   "v": 48,  "w": 256, "jp": "各国や種族同士が争い合い",       "en": "\"The age of nations and races"},
  {"seq": 74,  "page": "img1",  "u": 0,   "v": 72,  "w": 272, "jp": "血を流す時代は去りました",       "en": "warring in blood is over."},
  {"seq": 76,  "page": "img1",  "u": 0,   "v": 96,  "w": 272, "jp": "我々は共通の敵に向かって",       "en": "Against our common foe,"},
  {"seq": 77,  "page": "img1",  "u": 0,   "v": 120, "w": 272, "jp": "団結しなければなりません",       "en": "we must stand united."},
  {"seq": 79,  "page": "img1",  "u": 0,   "v": 144, "w": 264, "jp": "このベノアに住む",               "en": "For the peace of all"},
  {"seq": 80,  "page": "img1",  "u": 0,   "v": 168, "w": 264, "jp": "すべての者の平和のために",       "en": "who dwell in Venoa,"},
  {"seq": 82,  "page": "img1",  "u": 0,   "v": 192, "w": 264, "jp": "そして、散っていった",           "en": "and by the souls of"},
  {"seq": 83,  "page": "img1",  "u": 0,   "v": 216, "w": 264, "jp": "多くの勇者達の魂に誓い",         "en": "the many heroes who fell,"},
  {"seq": 85,  "page": "img1",  "u": 0,   "v": 240, "w": 288, "jp": "私はあらゆる闇の勢力に対する",   "en": "I swear to stand guardian"},
  {"seq": 86,  "page": "img1",  "u": 0,   "v": 264, "w": 264, "jp": "守護者になることを",             "en": "against all powers of dark."},
  {"seq": 87,  "page": "img1",  "u": 0,   "v": 288, "w": 264, "jp": "いまここで宣言します",           "en": "This I declare here and now."},
  {"seq": 89,  "page": "img1",  "u": 0,   "v": 312, "w": 264, "jp": "みなさんに紹介しましょう",       "en": "Let me present to you..."},
  {"seq": 91,  "page": "img0",  "u": 320, "v": 192, "w": 136, "jp": "冒険者達は",                     "en": "The adventurers"},
  {"seq": 93,  "page": "img0",  "u": 264, "v": 216, "w": 232, "jp": "列席者の中を進み出た",           "en": "stepped from the crowd."},
