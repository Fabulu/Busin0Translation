  {"seq": 103, "page": "img0",  "u": 264, "v": 336, "w": 240, "jp": "万雷の拍手が鳴り響く中",         "en": "Amid thunderous applause,"},
  {"seq": 105, "page": "img0",  "u": 264, "v": 360, "w": 240, "jp": "この光景は人々が永遠に",         "en": "this became a scene people"},
